# Required in production. Use an Upstash-compatible Redis REST database.
REDIS_REST_URL=
REDIS_REST_TOKEN=
# Public RPC only; never put a credential in a NEXT_PUBLIC variable.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Set to the exact production origin, e.g. https://sentri.example.com
APP_ORIGIN=http://localhost:3000
